# Required when processing a new Douyin link.
CANXIANG_API_TOKEN=your_canxiang_token_here

# Required for the default Qwen video worker.
DASHSCOPE_API_KEY=your_dashscope_key_here
VIDEO_WORKER=qwen

# API server and persistent video cache location.
PORT=5000
VIDEOEYE_CACHE_DIR=./data/videoeye

# Required by the included Vite frontends when building the whole workspace.
BASE_PATH=/

# Optional: select a supported DashScope region (cn-beijing or ap-southeast-1).
DASHSCOPE_REGION=cn-beijing

# Optional: only when explicitly selecting VIDEO_WORKER=gemini.
# GEMINI_API_KEY=your_gemini_key_here

# Optional: completed/failed job metadata retention. Default: 6 hours.
# VIDEOEYE_JOB_TTL_MS=21600000
